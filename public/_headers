# Served by Cloudflare Workers Static Assets. The API responses set their own headers in worker.ts / usage.ts.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Only Vite's fingerprinted JS, CSS and font files are immutable. HTML and sw.js must revalidate.
/app/*
  Cache-Control: public, max-age=31536000, immutable
