// www.im-dog.com: a tiny Worker that redirects every request to https://im-dog.com (same path and query), so the
// game has one address. It only runs for www traffic; im-dog.com itself is the Worker in wrangler.jsonc. Deployed with
// `npx wrangler deploy -c wrangler.www.jsonc`, and on every push to main by .github/workflows/deploy-cloudflare.yml.
{
	"name": "im-dog-www",
	"main": "./src/redirect/www.ts",
	// The owner's Cloudflare account (an ID, not a secret): saves the deploy from having to guess.
	"account_id": "81cc81e7dd4531da3968862517ab5e2b",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": false
	},
	// Only reachable at www.im-dog.com (Cloudflare adds the DNS record and certificate on deploy).
	"workers_dev": false,
	"routes": [
		{
			"pattern": "www.im-dog.com",
			"custom_domain": true
		}
	]
}
